<?xml version="1.0" encoding="UTF-8"?>
<!--
  Habilita o depurador remoto do painel.

  Com o After Effects aberto e o painel visível, abra http://localhost:8088 num
  navegador Chromium para ter DevTools completo: console, network, breakpoints.
  É a única forma prática de depurar o lado JS de uma extensão CEP.

  Este arquivo só tem efeito com PlayerDebugMode ligado — o `scripts/install-dev.sh`
  cuida disso.
-->
<ExtensionList>
  <Extension Id="ai.vectorize.ae.panel">
    <HostList>
      <Host Name="AEFT" Port="8088" />
    </HostList>
  </Extension>
</ExtensionList>
